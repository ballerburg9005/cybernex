[gd_resource type="Resource" script_class="CircuitPart" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/circuits/CircuitPart.gd" id="part"]
[ext_resource type="Script" path="res://systems/circuits/CircuitPin.gd" id="pin"]

[sub_resource type="Resource" id="Pin0"]
script = ExtResource("pin")
side = 0
offset = 0
name = "L"
wire_group = 0

[sub_resource type="Resource" id="Pin1"]
script = ExtResource("pin")
side = 2
offset = 0
name = "R"
wire_group = 0

[resource]
script = ExtResource("part")
part_id = "wire_straight"
label = "Thin salvaged wire"
model = "wire"
footprint = Vector2i(1, 1)
pins = Array[ExtResource("pin")]([SubResource("Pin0"), SubResource("Pin1")])
value = 0.06
secondary_value = 0.2
gain = 60
rated_watts = 0.2
thermal_capacity = 0.18
cooling_watts_per_kelvin = 0.04
failure_temperature_c = 95
can_remove = true
can_rotate = true
