[gd_scene load_steps=15 format=3]

[ext_resource type="Script" path="res://systems/circuits/CircuitWorkbench.gd" id="workbench"]
[ext_resource type="Script" path="res://systems/circuits/CircuitBoardView.gd" id="view"]
[ext_resource type="Script" path="res://systems/circuits/CircuitPart.gd" id="part_script"]
[ext_resource type="Resource" path="res://systems/circuits/boards/door_actuator.tres" id="board"]
[ext_resource type="Resource" path="res://systems/circuits/parts/resistor_10.tres" id="r"]
[ext_resource type="Resource" path="res://systems/circuits/parts/wire_straight.tres" id="wire"]
[ext_resource type="Resource" path="res://systems/circuits/parts/wire_corner.tres" id="corner"]
[ext_resource type="Resource" path="res://systems/circuits/parts/wire_junction.tres" id="junction"]
[ext_resource type="Resource" path="res://systems/circuits/parts/wire_crossover.tres" id="crossover"]
[ext_resource type="Resource" path="res://systems/circuits/parts/diode.tres" id="diode"]
[ext_resource type="Resource" path="res://systems/circuits/parts/npn.tres" id="npn"]
[ext_resource type="Resource" path="res://systems/circuits/parts/pnp.tres" id="pnp"]
[ext_resource type="Resource" path="res://systems/circuits/parts/nmos.tres" id="nmos"]
[ext_resource type="Resource" path="res://systems/circuits/parts/pmos.tres" id="pmos"]

[node name="CircuitWorkbench" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("workbench")
authored_board = ExtResource("board")
catalog = Array[ExtResource("part_script")]([ExtResource("r"), ExtResource("wire"), ExtResource("corner"), ExtResource("junction"), ExtResource("crossover"), ExtResource("diode"), ExtResource("npn"), ExtResource("pnp"), ExtResource("nmos"), ExtResource("pmos")])

[node name="Padding" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Layout" type="VBoxContainer" parent="Padding"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Header" type="Label" parent="Padding/Layout"]
layout_mode = 2
text = "CYBERNEX / MAINTENANCE TERMINAL 04   —   ACTUATOR REPAIR"

[node name="Description" type="Label" parent="Padding/Layout"]
layout_mode = 2
text = "A resistor is burned open. Select it and REMOVE; select a salvaged part and click the empty cell. Then RUN."
autowrap_mode = 3

[node name="MainRow" type="HBoxContainer" parent="Padding/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 22

[node name="BoardFrame" type="PanelContainer" parent="Padding/Layout/MainRow"]
layout_mode = 2

[node name="BoardView" type="Control" parent="Padding/Layout/MainRow/BoardFrame"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 0
script = ExtResource("view")
board = ExtResource("board")
cell_size = 68

[node name="SidePanel" type="VBoxContainer" parent="Padding/Layout/MainRow"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
theme_override_constants/separation = 12

[node name="PaletteLabel" type="Label" parent="Padding/Layout/MainRow/SidePanel"]
layout_mode = 2
text = "SALVAGE INVENTORY / PROTOTYPE"

[node name="Palette" type="OptionButton" parent="Padding/Layout/MainRow/SidePanel"]
unique_name_in_owner = true
layout_mode = 2

[node name="RotateButton" type="Button" parent="Padding/Layout/MainRow/SidePanel"]
unique_name_in_owner = true
layout_mode = 2
text = "ROTATE SELECTED"

[node name="RemoveButton" type="Button" parent="Padding/Layout/MainRow/SidePanel"]
unique_name_in_owner = true
layout_mode = 2
text = "REMOVE SELECTED"

[node name="RunButton" type="Button" parent="Padding/Layout/MainRow/SidePanel"]
unique_name_in_owner = true
layout_mode = 2
text = "RUN"

[node name="Status" type="Label" parent="Padding/Layout/MainRow/SidePanel"]
unique_name_in_owner = true
custom_minimum_size = Vector2(230, 90)
layout_mode = 2
text = "Open in Godot 4.7.2"
autowrap_mode = 3

[node name="Footnote" type="Label" parent="Padding/Layout"]
layout_mode = 2
text = "Proof of concept — part values and pin geometry are editable .tres Resources in Godot Inspector."

[node name="SolveTimer" type="Timer" parent="."]
unique_name_in_owner = true
wait_time = 0.05
